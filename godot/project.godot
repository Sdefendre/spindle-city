; Engine configuration file.
; Spindle City — native port of the browser game.

config_version=5

[application]

config/name="Spindle City"
config/description="Street-level open-world driving and exploration in Fall River and New Bedford."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.078, 0.133, 0.122, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.078, 0.133, 0.122, 1)

[shader_globals]

night_amount={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
